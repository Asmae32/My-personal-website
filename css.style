body {
    font-family: sans-serif;
    margin: 0;
    line-height: 1.6;
}

nav {
    display: flex;
    justify-content: space-between;
    padding: 1rem 2rem;
    background: #333;
    color: white;
}

nav ul {
    list-style: none;
    display: flex;
    gap: 1rem;
}

nav a {
    color: white;
    text-decoration: none;
}

.project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1rem;
    padding: 2rem;
}

.card {
    border: 1px solid #ddd;
    padding: 1rem;
    border-radius: 8px;
}
