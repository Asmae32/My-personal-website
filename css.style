/* 1. Define the new colors */
:root {
    --burgundy: #7B2F3A;
    --mustard: #C78F2A;
    --light-pink: #E6B7B0;
    --cream: #F1EDE9;
    --dark-brown: #4A2E2D;
}

/* 2. Apply to the body */
body {
    background-color: var(--cream); /* This sets the page background */
    color: var(--dark-brown);
    font-family: 'Quicksand', sans-serif;
    margin: 0;
    padding: 0;
    line-height: 1.6;
}

/* 3. Style the Navigation */
nav {
    background-color: var(--burgundy); /* Dark red top bar */
    color: var(--cream);
    padding: 1rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

nav h1 {
    margin: 0;
    font-family: 'Pacifico', cursive;
}

nav ul {
    list-style: none;
    display: flex;
    gap: 20px;
    margin: 0;
    padding: 0;
}

nav a {
    color: var(--cream);
    text-decoration: none;
    font-weight: 700;
}

/* 4. Style the Hero Section (Your Name) */
.hero {
    background-color: var(--light-pink); /* Soft pink background */
    text-align: center;
    padding: 4rem 2rem;
}

.hero h1 {
    font-family: 'Pacifico', cursive;
    font-size: 3rem;
    color: var(--burgundy); /* Dark red text */
    margin-bottom: 0.5rem;
}

.hero p {
    font-size: 1.2rem;
    color: var(--dark-brown);
}

/* 5. Style the Projects Section */
.projects {
    padding: 4rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
}

.projects h2 {
    font-family: 'Pacifico', cursive;
    color: var(--burgundy);
    text-align: center;
    font-size: 2.5rem;
    margin-bottom: 2rem;
}

.project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
}

.card {
    background-color: var(--cream);
    border: 2px solid var(--light-pink);
    border-radius: 15px;
    overflow: hidden;
    box-shadow: 0 4px 6px rgba(0,0,0,0.1);
}

.card img {
    width: 100%;
    height: 200px;
    object-fit: cover;
}

.card-content {
    padding: 1.5rem;
}

.card h3 {
    color: var(--burgundy);
    margin-top: 0;
}

/* 6. Style the Contact Section */
.contact {
    background-color: var(--burgundy);
    color: var(--cream);
    text-align: center;
    padding: 4rem 2rem;
}

.contact h2 {
    font-family: 'Pacifico', cursive;
    font-size: 2.5rem;
    margin-bottom: 1rem;
}

.btn {
    display: inline-block;
    background-color: var(--mustard); /* Golden button */
    color: var(--cream);
    padding: 10px 20px;
    text-decoration: none;
    border-radius: 25px;
    font-weight: 700;
    margin-top: 1rem;
}

footer {
    text-align: center;
    padding: 1rem;
    background-color: var(--dark-brown);
    color: var(--cream);
}
/* Experiences Section */
.experiences {
    padding: 4rem 2rem;
    max-width: 800px;
    margin: 0 auto;
}

.experiences h2 {
    text-align: center;
    font-family: 'Pacifico', cursive;
    color: var(--burgundy);
    font-size: 2.5rem;
    margin-bottom: 3rem;
}

.timeline {
    position: relative;
    padding-left: 30px;
    border-left: 2px solid var(--light-pink);
}

.timeline-item {
    position: relative;
    margin-bottom: 3rem;
}

/* The dot on the timeline */
.timeline-dot {
    position: absolute;
    left: -39px; /* Adjusts dot position to align with the line */
    top: 0;
    width: 16px;
    height: 16px;
    background-color: var(--mustard);
    border-radius: 50%;
    border: 3px solid var(--cream);
}

.timeline-date {
    font-weight: 700;
    color: var(--mustard);
    margin-bottom: 0.5rem;
    font-size: 0.9rem;
}

.timeline-content h3 {
    font-family: 'Quicksand', sans-serif;
    font-weight: 700;
    color: var(--burgundy);
    margin-bottom: 0.2rem;
}

.timeline-content h4 {
    font-weight: 600;
    color: var(--dark-brown);
    margin-bottom: 0.5rem;
    font-style: italic;
}

.timeline-content p {
    color: var(--dark-brown);
    line-height: 1.6;
}
