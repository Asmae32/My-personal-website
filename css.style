body {
    font-family: sans-serif;
    margin: 0;
    line-height: 1.6;
}

nav {
    display: flex;
    justify-content: space-between;
    padding: 1rem 2rem;
    background: #333;
    color: white;
}

nav ul {
    list-style: none;
    display: flex;
    gap: 1rem;
}

nav a {
    color: white;
    text-decoration: none;
}

.project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1rem;
    padding: 2rem;
}

.card {
    border: 1px solid #ddd;
    padding: 1rem;
    border-radius: 8px;
}
.hero h1 {
    font-family: 'Pacifico', cursive;
    font-size: 4rem; /* Makes the name very big */
    color: var(--pastel-blue); /* Uses your pastel blue */
    margin-bottom: 0.5rem;
    text-shadow: 2px 2px 0px var(--pastel-pink); /* Adds a sparkly pop */
}

.hero p {
    font-family: 'Quicksand', sans-serif;
    font-size: 1.5rem;
    color: var(--text-color);
    font-weight: 600;
}
html {
    scroll-behavior: smooth;
}
}